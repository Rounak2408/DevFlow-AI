# Server
NODE_ENV=development
PORT=4000

# MongoDB — local
MONGODB_URI=mongodb://127.0.0.1:27017/devflow

# MongoDB Atlas (cloud) — Atlas → Connect → Drivers, copy SRV string; set DB name before "?"
# Password me @ : / # ? ya space ho to URL-encode karo (e.g. @ → %40)
# MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@cluster0.sm74pcq.mongodb.net/devflow?retryWrites=true&w=majority&appName=Cluster0
# Optional: analytics works without Redis after server timeout fix; Redis needed for queues/caching.
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# LLM for DevFlow AI Assistant: openai | ollama | gemini
LLM_PROVIDER=openai

# OpenAI (default when LLM_PROVIDER=openai; also used by /api/ai task-breakdown unless you change code)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=90000

# Local Ollama (free, OpenAI-compatible API) — install https://ollama.com then: ollama pull llama3.2
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# Google Gemini (free tier with limits) — key from https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# (Older gemini-1.5-flash may return "model not found" for new API keys — see https://ai.google.dev/gemini-api/docs/models )
AI_CACHE_TTL=3600
# Assistant: set ASSISTANT_USE_QUEUE=1 to run completions via Bull (Redis). Short-lived response cache:
ASSISTANT_CACHE_TTL=180
ASSISTANT_JOB_MS=120000

# Analytics cache (seconds)
ANALYTICS_CACHE_TTL=120

# Client (Vite) — copy to client/.env for production builds
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
